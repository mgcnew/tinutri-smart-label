  "narrative": {
    "northStar": "The Organized Workbench",
    "overview": "The organized workbench brings the calm, practical character of the operational application to the public landing. White surfaces, green actions, fine divisions and compact controls make the product legible without decorative imagery.\n\nThis document covers only the public landing rendered by `src/components/landing/SystemLanding.tsx`, styled by `src/landing.css` and routed at `src/routes/sistema.tsx` (also reused at the public entry point). It does not redefine the authenticated application, shared authentication dialog, print templates or dark theme. The source implementation wins over the earlier direction contract: its division color is `colors.line`, and section headings inherit the existing DM Sans display family.",
    "keyCharacteristics": [
      "White surfaces with functional green emphasis.",
      "Calm density, generous section spacing and compact operational controls.",
      "Readable native controls and visible keyboard focus.",
      "Locally interactive examples clearly identified as fictitious."
    ],
    "rules": [
      {
        "name": "The Functional Green Rule",
        "body": "Use green for primary actions, selected controls, operational icons and concise heading emphasis. Reserve the amber pair for an attention status.",
        "section": "colors"
      },
      {
        "name": "The Existing Type Rule",
        "body": "Use the existing Manrope and DM Sans families; retain the Manrope hero override and the inherited DM Sans section headings.",
        "section": "typography"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Use borders and pale tonal grounds for ordinary grouping; reserve soft shadows for the product container, selected tab and illustrative label.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the white and green operational identity and established typography.",
      "Do keep interactive controls at least 44px tall and show visible keyboard focus.",
      "Do retain labels, text status explanations and explicit fictitious-data notices in the demonstration.",
      "Do stack columns and reflow rows on small screens instead of squeezing the desktop layout."
    ],
    "donts": [
      "Don't introduce photography, olive colors, editorial serif faces or decorative background lettering into this landing.",
      "Don't replace clear groups and dividers with a mosaic of promotional cards.",
      "Don't use the illustrative label styling as a specification for physical printed labels.",
      "Don't apply this landing document to the whole authenticated application."
    ]
  }
