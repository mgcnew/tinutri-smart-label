# Copie para .env e preencha. O .env real contém segredos: não o envie ao repositório.
VITE_SUPABASE_PROJECT_ID="seu-project-ref"
VITE_SUPABASE_URL="https://seu-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://seu-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Painel Supabase > Project Settings > API > service_role (secreta; só no servidor)
SUPABASE_SERVICE_ROLE_KEY=""
# Notificações push (gere o par com: node scripts/generate-vapid.mjs). A chave PÚBLICA vai aqui e no ambiente de publicação;
# a PRIVADA vai só nos segredos do Supabase (Edge Functions > Secrets), nunca neste arquivo nem no repositório.
VITE_VAPID_PUBLIC_KEY=""

# Contratação por link — somente no servidor. Instalação em docs/22-contratacao-por-link.md.
# Origem pública da aplicação (sem caminho). HTTPS em produção.
CONTRACT_PUBLIC_ORIGIN=""
# Deixe disabled até configurar a conta e homologar o sandbox.
CONTRACT_SIGNATURE_PROVIDER="disabled"
CONTRACT_SIGNATURE_ENVIRONMENT="sandbox"
CLICKSIGN_ACCESS_TOKEN=""
# HMAC SHA256 Secret do webhook da conta (não é o Access Token).
CLICKSIGN_WEBHOOK_SECRET=""
# Hosts exatos de downloads retornados pela API (separados por vírgula; sem URL ou wildcard).
CLICKSIGN_FILE_HOSTS=""
# Asaas: primeira integração exclusivamente sandbox, com cobrança integral do ciclo e renovação manual.
CONTRACT_PAYMENT_PROVIDER="disabled"
ASAAS_ENVIRONMENT="sandbox"
# Use aspas simples: a chave contém $. Nunca prefixar com VITE_.
ASAAS_API_KEY=''
# Token próprio do webhook, 32 a 255 caracteres; não reutilizar a API key.
ASAAS_WEBHOOK_TOKEN=""
# URL pública HTTPS exata do endpoint (não usar localhost) e e-mail técnico autorizado.
ASAAS_WEBHOOK_URL=""
ASAAS_WEBHOOK_EMAIL=""
# Só habilitar após homologar assinatura, Asaas e convites Supabase. Mantém ativação desligada.
CONTRACT_ACTIVATION_ENABLED="false"
